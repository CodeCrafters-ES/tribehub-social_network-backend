# =====================================
# CONFIGURACIÓN DE ENTORNO - EJEMPLO
# =====================================
# Copia este archivo a .env.development para desarrollo local.
# NUNCA pongas credenciales reales en este archivo.
# En Railway (producción/staging), configura cada variable directamente
# en el panel de Railway — no se usa ningún archivo .env en producción.

# Puerto del servidor
PORT=3000

# Entorno de la aplicación
# Valores válidos: development | staging | production
NODE_ENV=development

# Número de saltos de proxy de confianza (Express "trust proxy").
# Necesario para que req.ip sea la IP real del cliente (X-Forwarded-For) y el
# rate limiting por IP funcione correctamente detrás del proxy de Railway.
# NO uses un valor alto ni "true": permitiría falsificar la IP y evadir límites.
# Por defecto: 0 en development, 1 en staging/production (proxy de Railway).
TRUST_PROXY_HOPS=1

# =====================================
# CONFIGURACIÓN DE CORS
# =====================================
# Orígenes permitidos en producción (separados por coma).
# En development los orígenes están hardcodeados en main.ts.
CORS_ORIGINS=https://tu-frontend.netlify.app

# Orígenes permitidos en staging (separados por coma).
CORS_ORIGINS_STAGING=https://tribehub-frontend.netlify.app

# =====================================
# CONFIGURACIÓN DE SUPABASE
# =====================================
# Obtén estos valores en: https://supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key

# JWT Secret de Supabase: Settings → API → JWT Settings → JWT Secret
# Requerido por SupabaseAuthGuard para validar tokens Bearer.
SUPABASE_JWT_SECRET=tu-supabase-jwt-secret

# =====================================
# CONFIGURACIÓN DE JWT (interno)
# =====================================
# Secreto propio de la aplicación para tokens internos (futuro uso).
# Usa al menos 32 caracteres aleatorios.
JWT_SECRET=tu-jwt-secret-super-seguro-aqui
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=7

# =====================================
# BASE DE DATOS
# =====================================
# En desarrollo: URL de Supabase Pooler o PostgreSQL local.
# En Railway: Railway inyecta DATABASE_URL automáticamente.
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db

# =====================================
# SMOKE TESTS
# =====================================
SMOKE_USER_EMAIL=smoke@tribehub.app
SMOKE_USER_PASSWORD=TuPassword123!
SMOKE_BASE_URL=http://localhost:3000

# =====================================
# OTROS SERVICIOS
# =====================================
# Redis — en Railway, Railway inyecta REDIS_URL automáticamente.
# En desarrollo: instancia local o Upstash.
REDIS_URL=redis://localhost:6379
REDIS_TLS=false                          # true en Railway/producción con TLS

# TTL en segundos para la caché de feature flags (default: 60)
SYSTEM_CONFIG_CACHE_TTL_SECONDS=60

# URL pública del frontend (usada para redirecciones y CORS).
FRONTEND_URL=http://localhost:5173

# =====================================
# OBSERVABILIDAD — SENTRY
# =====================================
# DSN del proyecto en Sentry: https://sentry.io → tu proyecto → Settings → Client Keys
# Si no se define, Sentry arranca en modo "disabled" sin lanzar error.
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# =====================================
# OBSERVABILIDAD — MÉTRICAS PROMETHEUS
# =====================================
# Credenciales de Basic Auth para el endpoint de métricas.
# Sin estos valores el endpoint responde 503.
METRICS_USER=metrics_user
METRICS_PASS=metrics_pass_changeme

# Prefijo secreto del path de métricas.
# El endpoint final es: GET /api/v1/_internal/<METRICS_PATH_SECRET>-metrics
# Cambia este valor en producción por una cadena aleatoria e impredecible.
METRICS_PATH_SECRET=_internal_metrics_72a4b8

# =====================================
# Alertas — Discord
# =====================================
# Webhooks de Discord para alertas operativas de las colas BullMQ.
# Obtén la URL en: Discord → canal → Editar canal → Integraciones → Webhooks.
# Si no se definen, las alertas se omiten sin lanzar error.
DISCORD_WEBHOOK_CRITICAL=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_OPS=https://discord.com/api/webhooks/...

# Umbral de jobs en espera para disparar alerta ops (default: 50).
QUEUE_ALERT_WAITING_THRESHOLD=50

# Umbral de jobs fallidos para disparar alerta critical (default: 20).
QUEUE_ALERT_FAILED_THRESHOLD=20

# Intervalo de polling del monitor de colas en milisegundos (default: 60000).
QUEUE_MONITOR_INTERVAL_MS=60000

# =====================================
# Alertas — App/Infra
# =====================================
# Webhook de Discord para alertas de seguridad (canal #alerts-security).
DISCORD_WEBHOOK_SECURITY=https://discord.com/api/webhooks/...

# Ratio de respuestas 5xx sobre el total para disparar alerta critical (default: 0.05 = 5%).
APP_ALERT_5XX_RATE_THRESHOLD=0.05

# Latencia p95 en milisegundos para disparar alerta ops (default: 800).
APP_ALERT_LATENCY_P95_MS=800

# Ratio de heap usado sobre heap total para disparar alerta critical (default: 0.9 = 90%).
APP_ALERT_MEMORY_THRESHOLD=0.9

# Latencia de PING a Redis en milisegundos para disparar alerta ops (default: 50).
APP_ALERT_REDIS_LATENCY_MS=50

# Intervalo de polling del monitor de app/infra en milisegundos (default: 60000).
APP_MONITOR_INTERVAL_MS=60000

# =====================================
# Alertas — Seguridad
# =====================================
# Número de intentos de login fallidos en 5 minutos para disparar alerta (default: 10).
SECURITY_ALERT_BRUTE_FORCE_THRESHOLD=10

# Número de tokens inválidos en 5 minutos para disparar alerta (default: 50).
SECURITY_ALERT_INVALID_TOKEN_THRESHOLD=50

# Intervalo de polling del monitor de seguridad en milisegundos (default: 60000).
SECURITY_MONITOR_INTERVAL_MS=60000
